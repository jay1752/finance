# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/market_analysis

# Data Sources (Phase 1)
YAHOO_FINANCE_ENABLED=true
NSE_SCRAPING_ENABLED=false

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
DATA_UPDATE_TIME=17:00

# API Keys (Phase 2)
NEWSAPI_KEY=your_newsapi_key_here

# Paid Data Sources (Phase 3)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Redis (Phase 3)
REDIS_HOST=localhost
REDIS_PORT=6379
